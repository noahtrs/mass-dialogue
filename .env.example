# === SERVER-SIDE ENVIRONMENT VARIABLES (do NOT commit .env file) ===
# These are used by api/server.js and email/send-email.js — never exposed to the browser

# Supabase
SUPABASE_URL=https://your-project.supabase.co/
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key  # Server-only! Use anon key only in browser

# OpenAI
OPENAI_API_KEY=your-openai-api-key

# Google OAuth2 (for email/send-email.js)
CLIENT_ID=your-google-oauth-client-id
CLIENT_SECRET=your-google-oauth-client-secret
REDIRECT_URI=https://developers.google.com/oauthplayground
REFRESH_TOKEN=your-google-oauth-refresh-token
SENDER_EMAIL=your-email@gmail.com
SENDER_NAME=Mass Dialogue

# Recipients (comma-separated list)
RECIPIENT_LIST=recipient1@example.com,recipient2@example.com

# CORS: allowed frontend origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,https://mass-dialogue.yourdomain.com

# API server port
PORT=3001

# === CLIENT-SIDE ENVIRONMENT VARIABLES (exposed in browser bundle) ===
# React requires the REACT_APP_ prefix for browser code

# Supabase (anon key only — safe to expose, relies on RLS for security)
REACT_APP_SUPABASE_URL=https://your-project.supabase.co/
REACT_APP_SUPABASE_KEY=your-supabase-anon-key

# API server URL (not OpenAI key — API calls go through the server)
REACT_APP_API_BASE_URL=http://localhost:3001
